# ============================================================================
#  OmniVente — variables d'environnement
#  En local : copiez ce fichier en .env et remplissez-le.
# ============================================================================

# ---------- Base de données ----------
# En local, votre PostgreSQL :
DATABASE_URL=postgresql+psycopg2://omnivente:change_me_2026@localhost:5432/omnivente_db

# ---------- Agent conversationnel (Groq) ----------
# Clé gratuite : https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Application ----------
APP_ENV=development
DEFAULT_TENANT=kino-steak
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://omni-vente.vercel.app
# Motif optionnel pour un autre port local.
CORS_ORIGIN_REGEX=

# Crée les tables + importe le catalogue au démarrage.
AUTO_SEED=true
AUTO_SEED_DEMO=false

# ---------- Sondage e-mail ----------
MAIL_POLL_ENABLED=true
MAIL_POLL_SECONDS=30

# ---------- WhatsApp Business (API Cloud Meta) ----------
WHATSAPP_PHONE_NUMBER_ID=109387465120384
WHATSAPP_ACCESS_TOKEN=EAAG...
WHATSAPP_VERIFY_TOKEN=omnivente_kino_2026

# ---------- Instagram / Messenger (API Graph) ----------
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=omnivente_kino_2026

# ---------- E-mail de vente ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SALES_EMAIL=ventes@kinosteak.tg
SALES_EMAIL_APP_PASSWORD=
